# Base URL de l'API ProColis (Express).
# Dev via Docker (docker-compose mappe API_PORT -> 8080) : http://localhost:18081/api/v1
# Dev direct (npm run dev dans ProColis-Api, PORT=8080)   : http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:18081/api/v1

# URL publique de l'application (utilisée dans les emails, SMS, liens).
VITE_APP_URL=http://localhost:5173

# Clé API Google Maps (Places API + Maps JavaScript API).
# Activez les APIs suivantes dans Google Cloud Console :
#   - Places API
#   - Maps JavaScript API
#   - Geocoding API
# Restreignez la clé par domaine HTTP et IP pour la production.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCkhQClgzO_O2jB38WtQQDl6gDRyBrMXYc

# === Support Chat ===
# IDs et noms des utilisateurs "support" vers qui les messages du chat
# support sont dirigés. Créés automatiquement au bootstrap de l'API.
VITE_SUPPORT_COMMERCIAL_ID=3a3a3a3a-0000-4000-8000-000000000002
VITE_SUPPORT_COMMERCIAL_NAME=Support Commercial SENDPROCOLIS
VITE_SUPPORT_TECHNIC_ID=3a3a3a3a-0000-4000-8000-000000000001
VITE_SUPPORT_TECHNIC_NAME=Support Technique SENDPROCOLIS

# === Observabilité (remontée des erreurs navigateur) ===
# Inactive en développement quoi qu'il arrive : aucun collecteur n'écoute en local.
# `false` la désactive aussi en production.
VITE_FARO_ENABLED=true
# Chemin proxifié par Caddy vers le receiver Faro d'Alloy.
VITE_FARO_URL=/collect/faro
# Release estampillée sur chaque erreur. Doit correspondre au dossier
# ProColis-Api/deploy/observability/sourcemaps/<release>/ pour symboliser les stacks.
VITE_APP_RELEASE=dev
VITE_APP_ENV=development
