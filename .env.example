# Base URL de l'API ProColis (Express).
# Dev via Docker (docker-compose mappe API_PORT -> 8080) : http://localhost:18081/api/v1
# Dev direct (npm run dev dans ProColis-Api, PORT=8080)   : http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:18081/api/v1

# URL publique de l'application (utilisée dans les emails, SMS, liens).
VITE_APP_URL=http://localhost:5173

# Clé API Google Maps (Places API + Maps JavaScript API).
# Activez les APIs suivantes dans Google Cloud Console :
#   - Places API
#   - Maps JavaScript API
#   - Geocoding API
# Restreignez la clé par domaine HTTP et IP pour la production.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCkhQClgzO_O2jB38WtQQDl6gDRyBrMXYc

# === Formulaires Contact / Réclamations — envoi direct via Brevo ===
# Si l'API backend est injoignable, le message est envoyé directement à la
# boîte support via l'API Brevo (https://api.brevo.com/v3/smtp/email).
# Renseignez une clé dédiée (tableau de bord Brevo > SMTP & API > API Keys).
# ATTENTION : toute variable VITE_* est visible dans le bundle JS livré au
# navigateur. Utilisez une clé dédiée uniquement à cet usage, surveillez-la
# et révoquez-la en cas d'abus. L'anti-abus côté client limite à 3 envois/heure.
VITE_BREVO_API_KEY=
# Email expéditeur vérifié dans Brevo (l'email arrive "de" cette adresse).
VITE_BREVO_SENDER_EMAIL=no-reply@sendprocolis.com
VITE_BREVO_SENDER_NAME=SENDPROCOLIS

# === Support Chat ===
# IDs et noms des utilisateurs "support" vers qui les messages du chat
# support sont dirigés. Créés automatiquement au bootstrap de l'API.
VITE_SUPPORT_COMMERCIAL_ID=a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d
VITE_SUPPORT_COMMERCIAL_NAME=Support Commercial SENDPROCOLIS
VITE_SUPPORT_TECHNIC_ID=b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e7
VITE_SUPPORT_TECHNIC_NAME=Support Technique SENDPROCOLIS
