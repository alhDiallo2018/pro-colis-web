# Base URL de l'API ProColis (Express).
# Dev via Docker (docker-compose mappe API_PORT -> 8080) : http://localhost:18081/api/v1
# Dev direct (npm run dev dans ProColis-Api, PORT=8080)   : http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:18081/api/v1

# URL publique de l'application (utilisée dans les emails, SMS, liens).
VITE_APP_URL=http://localhost:5173

# Clé API Google Maps (Places API + Maps JavaScript API).
# Activez les APIs suivantes dans Google Cloud Console :
