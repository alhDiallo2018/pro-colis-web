# === Configuration de déploiement SendProColis ===
# Copier ce fichier vers `.env` sur le VPS et renseigner chaque valeur.
#   cp .env.production.example .env

# Domaine public (SANS https://). Un A record doit pointer vers l'IP du VPS.
DOMAIN=sendprocolis.exemple.com

# Email pour Let's Encrypt (avis d'expiration de certificat).
TLS_EMAIL=fc@futurschoisis.net

# Mot de passe Postgres — générer une valeur URL-safe (hex, PAS base64 :
# un / ou + casserait la DATABASE_URL de l'API) :
#   openssl rand -hex 24
POSTGRES_PASSWORD=remplace-moi

# Secrets JWT — générer chacun avec :
#   openssl rand -hex 32
JWT_ACCESS_SECRET=remplace-moi
JWT_REFRESH_SECRET=remplace-moi

# === Brevo (ex-SendinBlue) — notifications email & SMS ===
# Clé API v3 depuis le tableau de bord Brevo (SMTP & API > API Keys).
BREVO_API_KEY=xkeysib-remplace-moi
# Email expéditeur vérifié dans Brevo.
BREVO_SENDER_EMAIL=no-reply@sendprocolis.com
# Nom qui apparaît dans la boîte de réception.
BREVO_SENDER_NAME=SENDPROCOLIS
# Expéditeur SMS (max 11 caractères alphanumériques, ex: "SEND PRO COLIS").
BREVO_SMS_SENDER=SENDPROCOLIS
